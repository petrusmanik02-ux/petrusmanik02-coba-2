<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>English Grade 9: Report Text Interactive Learning</title>
    <!-- Tailwind CSS CDN (dengan fallback CSS mandiri di bawah agar tetap rapi meski offline di APK) -->
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        /* Fallback & Custom Styling Mandiri (Siap Offline di APK WebView) */
        :root {
            --primary: #1d4ed8;
            --primary-dark: #1e3a8a;
            --bg-main: #f1f5f9;
            --text-main: #0f172a;
        }
        * {
            box-sizing: border-box;
        }
        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            background-color: var(--bg-main);
            color: var(--text-main);
            margin: 0;
            padding: 0;
            user-select: none;
            -webkit-user-select: none;
        }

        /* Animasi Karakter SVG & Layar Alarm */
        @keyframes bounceSlow {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-12px); }
        }
        @keyframes waveHand {
            0%, 100% { transform: rotate(0deg); }
            25% { transform: rotate(22deg); }
            75% { transform: rotate(-16deg); }
        }
        @keyframes pulseAlarm {
            0%, 100% { background-color: #dc2626; }
            50% { background-color: #7f1d1d; }
        }
        @keyframes floatTrophy {
            0%, 100% { transform: translateY(0) scale(1); }
            50% { transform: translateY(-9px) scale(1.06); }
        }
        @keyframes pulseFlame {
            0%, 100% { transform: scale(1); opacity: 0.9; }
            50% { transform: scale(1.2); opacity: 1; }
        }

        .animate-bounce-slow {
            animation: bounceSlow 2s infinite ease-in-out;
        }
        .animate-wave {
            transform-origin: 70% 70%;
            animation: waveHand 1.1s infinite ease-in-out;
        }
        .animate-trophy {
            animation: floatTrophy 2s infinite ease-in-out;
        }
        .animate-flame {
            transform-origin: center bottom;
            animation: pulseFlame 1s infinite ease-in-out;
        }
        .alarm-screen {
            animation: pulseAlarm 0.75s infinite ease-in-out;
        }

        /* Canvas Konfeti */
        #confetti-canvas {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: 50;
        }
    </style>
</head>
<body class="min-h-screen flex flex-col justify-between antialiased bg-slate-100 text-slate-900">

    <!-- Canvas Efek Konfeti -->
    <canvas id="confetti-canvas"></canvas>

    <!-- Notifikasi Toast (Pengganti alert) -->
    <div id="toast-box" class="fixed top-5 left-1/2 transform -translate-x-1/2 z-50 hidden transition-all duration-300 w-11/12 max-w-md">
        <div class="bg-amber-600 text-white px-5 py-3.5 rounded-2xl shadow-xl font-semibold flex items-center gap-3 border border-amber-400">
            <svg class="w-6 h-6 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
            </svg>
            <span id="toast-message" class="text-sm">Pesan peringatan</span>
        </div>
    </div>

    <!-- HEADER STICKY -->
    <header class="bg-gradient-to-r from-blue-900 via-blue-800 to-indigo-700 text-white shadow-lg sticky top-0 z-40">
        <div class="max-w-4xl mx-auto px-4 py-3.5 flex flex-wrap items-center justify-between gap-3">
            <div class="flex items-center gap-3">
                <div class="bg-white/15 p-2.5 rounded-xl border border-white/20">
                    <svg class="w-7 h-7 text-amber-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
                    </svg>
                </div>
                <div>
                    <span class="text-[11px] font-bold uppercase tracking-widest text-blue-200 block">Bahasa Inggris SMP Kelas 9</span>
                    <h1 class="text-base sm:text-xl font-extrabold tracking-tight">Report Text Mastery</h1>
                </div>
            </div>

            <!-- Info Siswa & Timer (Muncul saat Kuis Aktif) -->
            <div id="active-exam-bar" class="hidden items-center gap-2 sm:gap-3">
                <div class="hidden md:flex flex-col text-right pr-2 border-r border-blue-400/30">
                    <span id="header-student-name" class="text-xs font-bold text-white truncate max-w-[140px]">Nama Siswa</span>
                    <span id="header-student-class" class="text-[11px] text-blue-200 font-medium">Kelas IX</span>
                </div>
                <div class="flex items-center gap-2 bg-rose-600 border border-rose-300/50 px-3.5 py-2 rounded-xl shadow-md">
                    <svg class="w-4 h-4 sm:w-5 sm:h-5 text-white animate-pulse" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                    <span class="text-xs font-medium text-rose-100 hidden sm:inline">Waktu:</span>
                    <span id="timer-display" class="font-mono text-base sm:text-lg font-extrabold tracking-wider">20:00</span>
                </div>
            </div>
        </div>
    </header>

    <!-- KONTEN UTAMA -->
    <main class="flex-grow max-w-4xl w-full mx-auto px-4 py-6 sm:py-8">

        <!-- ========================================================= -->
        <!-- BAGIAN 1: MATERI LENGKAP & FORM IDENTITAS SISWA           -->
        <!-- ========================================================= -->
        <section id="intro-section" class="space-y-6">

            <!-- Modul 1: Identify and Understand Report Texts -->
            <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-5 sm:p-7">
                <div class="flex flex-wrap items-center gap-2.5 mb-4 pb-3 border-b border-slate-100">
                    <span class="bg-blue-600 text-white font-extrabold px-3 py-1 rounded-lg text-xs">KOMPETENSI 1</span>
                    <h2 class="text-lg sm:text-xl font-extrabold text-slate-800">Identify and Understand Report Texts</h2>
                </div>

                <div class="space-y-4 text-sm text-slate-700 leading-relaxed">
                    <div class="bg-blue-50/70 border border-blue-200 rounded-xl p-4">
                        <h3 class="font-bold text-blue-900 mb-1">A. Definition & Social Function (Definisi & Tujuan Sosial)</h3>
                        <p>
                            <strong>Report Text</strong> adalah jenis teks dalam bahasa Inggris yang menyajikan informasi faktual mengenai suatu objek (hewan, tumbuhan, fenomena alam, benda teknologi, atau gejala sosial) secara <strong>umum (general)</strong> berdasarkan hasil observasi atau penelitian ilmiah.
                        </p>
                        <p class="mt-1.5 text-blue-950 font-medium">
                            🎯 <em>Social Function:</em> To describe the way things are in general, with reference to a range of natural, man-made, and social phenomena in our environment.
                        </p>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <!-- Generic Structure -->
                        <div class="bg-slate-50 border border-slate-200 rounded-xl p-4">
                            <h3 class="font-bold text-slate-900 mb-2 flex items-center gap-2">
                                <span class="w-2.5 h-2.5 rounded-full bg-indigo-600"></span>
                                B. Generic Structure (Struktur Teks)
                            </h3>
                            <ul class="space-y-2 text-xs sm:text-sm">
                                <li class="bg-white p-2.5 rounded-lg border border-slate-200">
                                    <strong class="text-indigo-700 block">1. General Classification (Klasifikasi Umum)</strong>
                                    Berisi pernyataan umum yang memperkenalkan objek yang dibahas, definisi ilmiah, atau klasifikasi kelompoknya.
                                </li>
                                <li class="bg-white p-2.5 rounded-lg border border-slate-200">
                                    <strong class="text-indigo-700 block">2. Description (Deskripsi Fakta)</strong>
                                    Menjelaskan bagian-bagian tubuh/komponen, ciri fisik, habitat, perilaku, kebiasaan, atau fungsi objek secara rinci dan objektif.
                                </li>
                            </ul>
                        </div>

                        <!-- Language Features -->
                        <div class="bg-slate-50 border border-slate-200 rounded-xl p-4">
                            <h3 class="font-bold text-slate-900 mb-2 flex items-center gap-2">
                                <span class="w-2.5 h-2.5 rounded-full bg-emerald-600"></span>
                                C. Language Features (Ciri Kebahasaan)
                            </h3>
                            <ul class="space-y-1.5 text-xs sm:text-sm list-disc list-inside text-slate-700">
                                <li><strong>General Nouns:</strong> Kata benda umum (e.g., <em>Mangrove trees, Komodo dragons, Earthquakes</em>), bukan spesifik (<em>My cat</em>).</li>
                                <li><strong>Simple Present Tense:</strong> Menyatakan fakta ilmiah/kebenaran umum (e.g., <em>They live in coastal areas</em>).</li>
                                <li><strong>Relating Verbs:</strong> Kata kerja penghubung (<em>is, am, are, have, belong to, consist of</em>).</li>
                                <li><strong>Technical / Scientific Terms:</strong> Istilah ilmiah (e.g., <em>ecosystem, reptile, photosynthesis, habitat</em>).</li>
                                <li><strong>Passive Voice:</strong> Menekankan objek fakta (e.g., <em>Mangroves are found in tropical coasts</em>).</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Modul 2: Write Report Text + Contoh Teks Beranotasi -->
            <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-5 sm:p-7">
                <div class="flex flex-wrap items-center gap-2.5 mb-4 pb-3 border-b border-slate-100">
                    <span class="bg-emerald-600 text-white font-extrabold px-3 py-1 rounded-lg text-xs">KOMPETENSI 2</span>
                    <h2 class="text-lg sm:text-xl font-extrabold text-slate-800">Write Report Text (Langkah & Contoh Teks)</h2>
                </div>

                <!-- 4 Langkah Menulis Report Text -->
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 mb-6">
                    <div class="bg-emerald-50/70 border border-emerald-200 rounded-xl p-3.5">
                        <span class="text-xs font-black text-emerald-700 block mb-1">STEP 1</span>
                        <h4 class="font-bold text-slate-800 text-sm mb-1">Tentukan Topik Umum</h4>
                        <p class="text-xs text-slate-600">Pilih objek umum (bukan milik pribadi), misal: <em>Mangrove Forest</em>.</p>
                    </div>
                    <div class="bg-emerald-50/70 border border-emerald-200 rounded-xl p-3.5">
                        <span class="text-xs font-black text-emerald-700 block mb-1">STEP 2</span>
                        <h4 class="font-bold text-slate-800 text-sm mb-1">Riset Fakta Objektif</h4>
                        <p class="text-xs text-slate-600">Kumpulkan data ilmiah (habitat, ciri fisik, manfaat) tanpa opini pribadi.</p>
                    </div>
                    <div class="bg-emerald-50/70 border border-emerald-200 rounded-xl p-3.5">
                        <span class="text-xs font-black text-emerald-700 block mb-1">STEP 3</span>
                        <h4 class="font-bold text-slate-800 text-sm mb-1">Susun Kerangka Teks</h4>
                        <p class="text-xs text-slate-600">Paragraf 1: <em>General Classification</em>. Paragraf 2+: <em>Description</em>.</p>
                    </div>
                    <div class="bg-emerald-50/70 border border-emerald-200 rounded-xl p-3.5">
                        <span class="text-xs font-black text-emerald-700 block mb-1">STEP 4</span>
                        <h4 class="font-bold text-slate-800 text-sm mb-1">Sunting Tata Bahasa</h4>
                        <p class="text-xs text-slate-600">Pastikan memakai <em>Simple Present Tense</em>, <em>Passive Voice</em>, dan istilah tepat.</p>
                    </div>
                </div>

                <!-- Contoh Utuh Report Text dengan Anotasi -->
                <div class="bg-slate-50 border border-slate-200 rounded-2xl p-4 sm:p-5">
                    <div class="flex items-center justify-between mb-3">
                        <span class="text-xs font-extrabold uppercase tracking-wider text-slate-500">Contoh Report Text Beranotasi</span>
                        <span class="text-xs bg-indigo-100 text-indigo-800 font-bold px-2.5 py-0.5 rounded-full">Model Text</span>
                    </div>
                    <h3 class="text-lg font-extrabold text-slate-900 mb-3 text-center">Mangrove Forests</h3>

                    <div class="space-y-3 text-sm leading-relaxed">
                        <!-- Paragraf 1: General Classification -->
                        <div class="bg-white border-l-4 border-blue-600 p-3.5 rounded-r-xl shadow-xs">
                            <span class="inline-block text-[11px] font-extrabold uppercase bg-blue-100 text-blue-800 px-2 py-0.5 rounded mb-1.5">
                                General Classification (Klasifikasi & Definisi Umum)
                            </span>
                            <p class="text-slate-800">
                                <strong>Mangrove forests</strong> <span class="underline decoration-blue-400">are</span> coastal wetland ecosystems that <span class="underline decoration-blue-400">grow</span> in tropical and subtropical regions. They <span class="underline decoration-emerald-500 font-medium">are characterized</span> by salt-tolerant trees and shrubs that thrive in intertidal zones where freshwater meets saltwater.
                            </p>
                        </div>

                        <!-- Paragraf 2: Description -->
                        <div class="bg-white border-l-4 border-emerald-600 p-3.5 rounded-r-xl shadow-xs">
                            <span class="inline-block text-[11px] font-extrabold uppercase bg-emerald-100 text-emerald-800 px-2 py-0.5 rounded mb-1.5">
                                Description (Ciri Fisik, Fungsi Ekologis & Fakta Ilmiah)
                            </span>
                            <p class="text-slate-800">
                                Mangrove trees <span class="underline decoration-blue-400">possess</span> complex, tangled prop roots that stabilize coastlines and prevent erosion from waves and storms. In addition, dense mangrove roots <span class="underline decoration-emerald-500 font-medium">are used</span> as nursery habitats by various species of fish, crabs, and shrimp. Today, mangrove conservation programs <span class="underline decoration-emerald-500 font-medium">are promoted</span> globally because these forests absorb large amounts of carbon dioxide.
                            </p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Modul 3: Form Identitas & Mulai Kuis -->
            <div class="bg-white rounded-2xl shadow-md border-2 border-blue-200 p-5 sm:p-7">
                <h2 class="text-xl font-extrabold text-slate-900 mb-1">Identitas Peserta Kuis Evaluasi</h2>
                <p class="text-sm text-slate-500 mb-5">Lengkapi Nama dan Kelas Anda di bawah ini untuk membuka 5 soal PG HOTS berstimulus.</p>

                <!-- Kotak Peringatan Anti-Cheat -->
                <div class="bg-rose-50 border-l-4 border-rose-600 p-4 rounded-r-xl mb-6">
                    <div class="flex items-start gap-3">
                        <svg class="w-6 h-6 text-rose-600 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
                        </svg>
                        <div class="text-xs sm:text-sm text-rose-950 space-y-1">
                            <p class="font-extrabold text-rose-700">PERATURAN UJIAN & SISTEM ANTI-CURANG:</p>
                            <ul class="list-disc list-inside space-y-0.5 text-rose-900">
                                <li>Durasi pengerjaan adalah <strong>20 menit</strong> (hitung mundur otomatis).</li>
                                <li><strong>DILARANG berpindah tab browser, membuka aplikasi lain, atau meminimalkan layar</strong> selama ujian berlangsung.</li>
                                <li>Jika Anda beralih tab/keluar layar, sistem otomatis mengubah layar menjadi <strong>MERAH</strong>, membunyikan <strong>ALARM KERAS</strong>, dan menyatakan ujian <strong>GAGAL / DISKUALIFIKASI</strong>.</li>
                            </ul>
                        </div>
                    </div>
                </div>

                <form id="start-form" class="space-y-4">
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div>
                            <label for="student-name" class="block text-sm font-bold text-slate-700 mb-1.5">Nama Lengkap Siswa <span class="text-rose-600">*</span></label>
                            <input type="text" id="student-name" placeholder="Masukkan nama lengkap..." required
                                class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:ring-2 focus:ring-blue-600 focus:border-blue-600 outline-none transition text-slate-900 bg-slate-50 focus:bg-white font-medium">
                        </div>
                        <div>
                            <label for="student-class" class="block text-sm font-bold text-slate-700 mb-1.5">Kelas <span class="text-rose-600">*</span></label>
                            <input type="text" id="student-class" placeholder="Contoh: IX-A / 9B" required
                                class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:ring-2 focus:ring-blue-600 focus:border-blue-600 outline-none transition text-slate-900 bg-slate-50 focus:bg-white font-medium">
                        </div>
                    </div>

                    <button type="submit"
                        class="w-full mt-2 bg-gradient-to-r from-blue-700 to-indigo-700 hover:from-blue-800 hover:to-indigo-800 text-white font-extrabold py-4 px-6 rounded-xl shadow-lg shadow-blue-200 transition transform active:scale-[0.99] flex items-center justify-center gap-2 text-base cursor-pointer">
                        <span>Mulai Kuis Evaluasi (20 Menit)</span>
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/>
                        </svg>
                    </button>
                </form>
            </div>
        </section>

        <!-- ========================================================= -->
        <!-- BAGIAN 2: HALAMAN SOAL KUIS (5 SOAL PG HOTS BERSTIMULUS)   -->
        <!-- ========================================================= -->
        <section id="quiz-section" class="hidden space-y-6">
            <!-- Banner Status Peserta -->
            <div class="bg-white rounded-2xl shadow-sm border border-slate-200 px-5 py-3.5 flex flex-wrap items-center justify-between gap-2">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-full bg-blue-100 text-blue-800 font-extrabold flex items-center justify-center text-base" id="avatar-initials">
                        S
                    </div>
                    <div>
                        <p class="text-sm font-extrabold text-slate-900" id="display-name">Nama Siswa</p>
                        <p class="text-xs text-slate-500">Kelas: <span id="display-class" class="font-bold text-blue-700">IX</span></p>
                    </div>
                </div>
                <div class="text-xs font-bold bg-rose-50 text-rose-700 border border-rose-200 px-3 py-1.5 rounded-lg flex items-center gap-2">
                    <span class="w-2.5 h-2.5 rounded-full bg-rose-600 animate-ping"></span>
                    Pengawas Tab Aktif
                </div>
            </div>

            <!-- Kontainer 5 Soal HOTS -->
            <div id="questions-container" class="space-y-6"></div>

            <!-- Tombol Submit Jawaban -->
            <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-5 flex flex-col sm:flex-row items-center justify-between gap-4">
                <p class="text-sm text-slate-600 text-center sm:text-left">
                    Periksa kembali seluruh <strong>5 soal HOTS</strong> sebelum mengumpulkan jawaban.
                </p>
                <button type="button" id="submit-quiz-btn"
                    class="w-full sm:w-auto bg-emerald-600 hover:bg-emerald-700 text-white font-extrabold py-3.5 px-8 rounded-xl shadow-md shadow-emerald-200 transition transform active:scale-95 flex items-center justify-center gap-2 cursor-pointer">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                    </svg>
                    <span>Selesai & Lihat Nilai</span>
                </button>
            </div>
        </section>

        <!-- ========================================================= -->
        <!-- BAGIAN 3: HALAMAN HASIL & UMPAN BALIK ANIMASI             -->
        <!-- ========================================================= -->
        <section id="result-section" class="hidden space-y-6">
            <div class="bg-white rounded-3xl shadow-xl border border-slate-200 p-6 sm:p-10 text-center relative overflow-hidden">
                
                <!-- Ilustrasi Karakter Animasi SVG -->
                <div id="result-animation-box" class="mx-auto w-44 h-44 mb-4 flex items-center justify-center"></div>

                <!-- Badge Status -->
                <div id="result-badge" class="inline-block px-4 py-1.5 rounded-full text-xs sm:text-sm font-extrabold uppercase tracking-wider mb-3">
                    STATUS
                </div>

                <!-- Judul Besar Hasil -->
                <h2 id="result-title" class="text-2xl sm:text-4xl font-black mb-2 tracking-tight">
                    HASIL EVALUASI
                </h2>

                <!-- Identitas Siswa -->
                <p class="text-slate-600 text-sm sm:text-base mb-6">
                    Peserta: <strong id="res-name" class="text-slate-900">Nama</strong> &bull; Kelas: <strong id="res-class" class="text-blue-700">Kelas</strong>
                </p>

                <!-- Kotak Skor Akhir -->
                <div class="max-w-xs mx-auto bg-slate-50 border-2 border-slate-200 rounded-2xl p-5 mb-6">
                    <span class="text-xs font-extrabold uppercase tracking-widest text-slate-400 block mb-1">Skor Akhir</span>
                    <div class="text-5xl sm:text-6xl font-black" id="res-score">100</div>
                    <p class="text-xs font-medium text-slate-500 mt-2" id="res-detail">Benar 5 dari 5 soal</p>
                </div>

                <!-- Pesan Motivasi -->
                <p id="result-message" class="max-w-lg mx-auto text-slate-700 text-sm sm:text-base leading-relaxed mb-8"></p>

                <!-- Tombol Coba Lagi -->
                <button type="button" onclick="resetApplication()"
                    class="bg-blue-700 hover:bg-blue-800 text-white font-extrabold py-3.5 px-8 rounded-xl shadow-lg shadow-blue-200 transition transform active:scale-95 inline-flex items-center gap-2 cursor-pointer">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
                    </svg>
                    <span>Coba Lagi / Kembali ke Materi</span>
                </button>
            </div>

            <!-- Rincian Pembahasan Soal -->
            <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-5 sm:p-7">
                <h3 class="text-lg font-extrabold text-slate-800 mb-4 flex items-center gap-2">
                    <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
