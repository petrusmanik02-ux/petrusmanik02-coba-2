    <!-- ========================================================= -->
    <!-- JAVASCRIPT: SOAL HOTS, TIMER, ANTI-CHEAT & WEB AUDIO API  -->
    <!-- ========================================================= -->
    <script>
        // 1. DATA 5 SOAL PG HOTS BERSTIMULUS (REPORT TEXT)
        const quizQuestions = [
            {
                id: 1,
                topic: "1. Identify & Understand Report Text (Fungsi Sosial & Perbedaan Teks)",
                stimulusTitle: "Read the two text excerpts below carefully:",
                stimulusText: `<div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs sm:text-sm">
                    <div class="bg-white p-3 rounded-lg border border-slate-200">
                        <strong class="text-blue-700 block mb-1">Text A:</strong>
                        "Komodo dragons (<em>Varanus komodoensis</em>) are the largest living lizards on Earth. They inhabit dry, open grassland and savanna on several Indonesian islands."
                    </div>
                    <div class="bg-white p-3 rounded-lg border border-slate-200">
                        <strong class="text-amber-700 block mb-1">Text B:</strong>
                        "Rango is my pet lizard at home. He is very tame and loves sleeping on a warm rock inside his glass terrarium every afternoon."
                    </div>
                </div>`,
                question: "Based on the language features and social function, why is <strong>Text A</strong> classified as a <em>Report Text</em> while <strong>Text B</strong> is a <em>Descriptive Text</em>?",
                options: [
                    "A. Text A uses Past Tense to tell a historical story, while Text B uses Future Tense.",
                    "B. Text A describes a species scientifically in general, whereas Text B describes a specific, individual pet.",
                    "C. Text A aims to persuade readers to protect lizards, while Text B explains how to care for pets.",
                    "D. Text A contains personal opinions of the writer, whereas Text B presents scientific facts."
                ],
                correctIndex: 1,
                explanation: "Report Text (Text A) mendeskripsikan objek secara umum dan ilmiah (Komodo dragons sebagai spesies), sedangkan Descriptive Text (Text B) mendeskripsikan satu objek khusus/spesifik (Rango, peliharaan penulis)."
            },
            {
                id: 2,
                topic: "1. Identify & Understand Report Text (Struktur Teks & Informasi Tersirat)",
                stimulusTitle: "Read the following Report Text excerpt:",
                stimulusText: `<strong>Tsunamis</strong><br>
                A tsunami is a series of extremely long waves caused by a large and sudden displacement of the ocean, usually the result of an earthquake below or near the ocean floor. This force creates waves that radiate outward in all directions away from their source, sometimes crossing entire ocean basins.<br><br>
                Unlike wind-driven waves, which only travel through the topmost layer of the ocean, tsunamis move through the entire water column, from the ocean floor to the ocean surface. As a tsunami approaches shallow coastal waters, <strong>its</strong> speed decreases, but its height grows dramatically, causing severe flooding on land.`,
                question: "What can be inferred from the second paragraph, and what does the bold word <em>\"its\"</em> in the last sentence refer to?",
                options: [
                    "A. Wind-driven waves are deeper than tsunamis; 'its' refers to shallow coastal waters.",
                    "B. Tsunamis carry energy through the whole depth of the ocean and become taller near the shore; 'its' refers to a tsunami.",
                    "C. Tsunamis travel faster when reaching shallow beaches; 'its' refers to the ocean floor.",
                    "D. Earthquakes only occur on land; 'its' refers to severe flooding."
                ],
                correctIndex: 1,
                explanation: "Paragraf kedua menjelaskan bahwa gelombang tsunami bergerak melalui seluruh kolom air laut dan tingginya meningkat drastis saat mendekati perairan pantai dangkal. Kata ganti 'its' merujuk pada 'a tsunami'."
            },
            {
                id: 3,
                topic: "2. Write Report Text (Menyusun Kalimat Acak Menjadi Paragraf Padu)",
                stimulusTitle: "Examine the jumbled sentences for a Report Text about 'Coral Reefs':",
                stimulusText: `<ol class="list-decimal list-inside space-y-1 text-xs sm:text-sm bg-white p-3 rounded-lg border border-slate-200">
                    <li>These structures are secreted by tiny marine animals called coral polyps.</li>
                    <li>Coral reefs are diverse underwater ecosystems held together by calcium carbonate structures.</li>
                    <li>Consequently, they provide shelter and food for about 25 percent of all marine species.</li>
                    <li>They mostly grow in warm, shallow, clear, and sunlit tropical waters.</li>
                </ol>`,
                question: "Which arrangement forms the most coherent and logical paragraph starting from <em>General Classification</em> to <em>Description</em>?",
                options: [
                    "A. 2 – 1 – 4 – 3",
                    "B. 1 – 2 – 3 – 4",
                    "C. 2 – 4 – 3 – 1",
                    "D. 4 – 2 – 1 – 3"
                ],
                correctIndex: 0,
                explanation: "Kalimat (2) adalah General Classification (definisi umum Coral reefs), diikuti (1) penjelasan struktur pembentuknya ('These structures'), (4) habitat tumbuhnya, dan (3) kesimpulan manfaat ekologisnya ('Consequently')."
            },
            {
                id: 4,
                topic: "2. Write Report Text (Menyunting Kalimat Sesuai Kaidah Objektif Report Text)",
                stimulusTitle: "Read a student's draft of a Report Text below:",
                stimulusText: `<strong>Bornean Orangutans</strong><br>
                (1) Bornean orangutans are great apes native to the island of Borneo. (2) They have long, reddish-brown hair and strong arms for swinging through trees. (3) <em>I think they look super cute and funny when they eat bananas in the zoo!</em> (4) Currently, their population is threatened by deforestation and habitat loss.`,
                question: "Sentence (3) is inappropriate for a formal <em>Report Text</em> because it is subjective. Which revision best replaces sentence (3) to maintain an objective, scientific tone?",
                options: [
                    "A. Everyone loves watching orangutans because they are very adorable animals.",
                    "B. Last week, my family saw two orangutans eating fruits in the forest.",
                    "C. Their diet consists mainly of wild fruits, leaves, bark, and insects found in the rainforest canopy.",
                    "D. Please do not feed orangutans when you visit their conservation center."
                ],
                correctIndex: 2,
                explanation: "Report text harus objektif, faktual, menggunakan Simple Present Tense, dan bebas dari opini pribadi ('I think... cute'). Pilihan C menyajikan fakta ilmiah tentang pola makan orangutan secara objektif."
            },
            {
                id: 5,
                topic: "1 & 2. Identify & Complete Report Text (Analisis Fakta & Passive Voice)",
                stimulusTitle: "Analyze the Fact Table and incomplete Report Text below:",
                stimulusText: `<div class="bg-white p-3 rounded-lg border border-slate-200 text-xs sm:text-sm space-y-2">
                    <div class="bg-slate-100 p-2 rounded font-mono text-xs">
                        <strong>Fact Sheet — Rafflesia arnoldii:</strong><br>
                        • Status: Largest individual flower in the world | Habitat: Rainforests of Sumatra & Bengkulu<br>
                        • Pollination: Emits strong odor of decaying flesh → attracts carrion flies
                    </div>
                    <p>
                        <strong>Text Excerpt:</strong><br>
                        <em>Rafflesia arnoldii</em> is famous for producing the largest individual flower on Earth. It grows in the rainforests of Sumatra. Because this parasitic plant has no leaves or roots, nutrients (1) ______ directly from its host vine. When it blooms, carrion flies (2) ______ by its strong odor to help pollination.
                    </p>
                </div>`,
                question: "Which pair of verbs accurately completes blanks (1) and (2) using proper grammatical agreement in Simple Present Passive?",
                options: [
                    "A. (1) is absorbed — (2) is attracted",
                    "B. (1) are absorbed — (2) are attracted",
                    "C. (1) absorbed — (2) attracting",
                    "D. (1) was absorbed — (2) were attracted"
                ],
                correctIndex: 1,
                explanation: "Subjek (1) 'nutrients' (jamak) dan subjek (2) 'carrion flies' (jamak) keduanya membutuhkan bentuk Simple Present Passive jamak: 'are absorbed' dan 'are attracted'."
            }
        ];

        // 2. VARIABEL STATE APLIKASI
        let studentName = "";
        let studentClass = "";
        let isQuizActive = false;
        let timeRemaining = 20 * 60; // 20 menit = 1200 detik
        let timerInterval = null;
        let alarmInterval = null;
        let audioCtx = null;

        // 3. GENERATOR AUDIO MANDIRI (WEB AUDIO API - TANPA MP3 EKSTERNAL)
        function initAudioContext() {
            try {
                if (!audioCtx) {
                    const AudioContextClass = window.AudioContext || window.webkitAudioContext;
                    audioCtx = new AudioContextClass();
                }
                if (audioCtx.state === 'suspended') {
                    audioCtx.resume();
                }
            } catch (e) {
                console.warn("Web Audio API tidak tersedia:", e);
            }
        }

        // Bunyi Alarm Sirene Keras saat Pindah Tab / Keluar Layar
        function startAlarmSound() {
            try {
                initAudioContext();
                stopAlarmSound();

                let togglePitch = true;
                const triggerSireneTone = () => {
                    if (!audioCtx) return;
                    const osc = audioCtx.createOscillator();
                    const gain = audioCtx.createGain();
                    osc.type = 'sawtooth';
                    osc.frequency.setValueAtTime(togglePitch ? 920 : 640, audioCtx.currentTime);
                    togglePitch = !togglePitch;

                    gain.gain.setValueAtTime(0.3, audioCtx.currentTime);
                    gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 0.34);

                    osc.connect(gain);
                    gain.connect(audioCtx.destination);
                    osc.start();
                    osc.stop(audioCtx.currentTime + 0.35);
                };

                triggerSireneTone();
                alarmInterval = setInterval(triggerSireneTone, 380);
            } catch (e) {
                console.warn(e);
            }
        }

        function stopAlarmSound() {
            if (alarmInterval) {
                clearInterval(alarmInterval);
                alarmInterval = null;
            }
        }

        // Bunyi Fanfare Kemenangan (Skor > 80)
        function playVictorySound() {
            try {
                initAudioContext();
                const melody = [523.25, 659.25, 783.99, 1046.50]; // C5 - E5 - G5 - C6
                melody.forEach((freq, i) => {
                    const osc = audioCtx.createOscillator();
                    const gain = audioCtx.createGain();
                    osc.type = 'triangle';
                    osc.frequency.setValueAtTime(freq, audioCtx.currentTime + i * 0.14);

                    gain.gain.setValueAtTime(0.28, audioCtx.currentTime + i * 0.14);
                    gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + i * 0.14 + 0.45);

                    osc.connect(gain);
                    gain.connect(audioCtx.destination);
                    osc.start(audioCtx.currentTime + i * 0.14);
                    osc.stop(audioCtx.currentTime + i * 0.14 + 0.46);
                });
            } catch (e) {
                console.warn(e);
            }
        }

        // Bunyi Nada Penyemangat (Skor <= 80)
        function playEncourageSound() {
            try {
                initAudioContext();
                const melody = [440, 493.88, 523.25]; // A4 - B4 - C5
                melody.forEach((freq, i) => {
                    const osc = audioCtx.createOscillator();
                    const gain = audioCtx.createGain();
                    osc.type = 'sine';
                    osc.frequency.setValueAtTime(freq, audioCtx.currentTime + i * 0.18);

                    gain.gain.setValueAtTime(0.22, audioCtx.currentTime + i * 0.18);
                    gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + i * 0.18 + 0.4);

                    osc.connect(gain);
                    gain.connect(audioCtx.destination);
                    osc.start(audioCtx.currentTime + i * 0.18);
                    osc.stop(audioCtx.currentTime + i * 0.18 + 0.42);
                });
            } catch (e) {
                console.warn(e);
            }
        }

        // 4. PESAN NOTIFIKASI TOAST (PENGGANTI ALERT)
        function showToast(message) {
            const box = document.getElementById('toast-box');
            document.getElementById('toast-message').textContent = message;
            box.classList.remove('hidden');
            setTimeout(() => {
                box.classList.add('hidden');
            }, 3500);
        }

        // 5. VALIDASI IDENTITAS & AKTIVASI SISTEM KUIS
        document.getElementById('start-form').addEventListener('submit', function (e) {
            e.preventDefault();
            const nameVal = document.getElementById('student-name').value.trim();
            const classVal = document.getElementById('student-class').value.trim();

            if (!nameVal || !classVal) {
                showToast("Harap isi Nama Lengkap dan Kelas terlebih dahulu!");
                return;
            }

            studentName = nameVal;
            studentClass = classVal;

            // Buka izin Web Audio API melalui klik user
            initAudioContext();

            // Set Info Identitas di Header & Banner Kuis
            document.getElementById('header-student-name').textContent = studentName;
            document.getElementById('header-student-class').textContent = `Kelas: ${studentClass}`;
            document.getElementById('display-name').textContent = studentName;
            document.getElementById('display-class').textContent = studentClass;
            document.getElementById('avatar-initials').textContent = studentName.charAt(0).toUpperCase();

            // Render 5 Soal HOTS
            renderQuestions();

            // Ubah Tampilan Halaman
            document.getElementById('intro-section').classList.add('hidden');
            document.getElementById('result-section').classList.add('hidden');
            document.getElementById('quiz-section').classList.remove('hidden');
            document.getElementById('active-exam-bar').classList.remove('hidden');
            document.getElementById('active-exam-bar').classList.add('flex');

            // Aktifkan Mode Ujian & Timer 20 Menit
            isQuizActive = true;
            startCountdownTimer();
            window.scrollTo({ top: 0, behavior: 'smooth' });
        });

        // 6. RENDER 5 SOAL HOTS BERSTIMULUS
        function renderQuestions() {
            const container = document.getElementById('questions-container');
            container.innerHTML = '';

            quizQuestions.forEach((q, index) => {
                const card = document.createElement('div');
                card.className = "bg-white rounded-2xl shadow-sm border border-slate-200 p-5 sm:p-7 transition hover:border-blue-300";

                let optionsMarkup = '';
                q.options.forEach((opt, optIndex) => {
                    optionsMarkup += `
                        <label class="flex items-start gap-3 p-3.5 rounded-xl border border-slate-200 cursor-pointer hover:bg-blue-50/60 hover:border-blue-300 transition has-[:checked]:bg-blue-50 has-[:checked]:border-blue-600 has-[:checked]:ring-1 has-[:checked]:ring-blue-600">
                            <input type="radio" name="question_${q.id}" value="${optIndex}" class="mt-1 w-4 h-4 text-blue-600 focus:ring-blue-500 border-slate-300">
                            <span class="text-sm sm:text-base text-slate-800 leading-snug">${opt}</span>
                        </label>
                    `;
                });

                card.innerHTML = `
                    <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
                        <span class="bg-blue-700 text-white text-xs font-extrabold px-3 py-1 rounded-lg">SOAL ${index + 1} DARI 5 &bull; HOTS</span>
                        <span class="text-xs font-semibold text-slate-500">${q.topic}</span>
                    </div>

                    <!-- Stimulus Soal -->
                    <div class="bg-amber-50/70 border-l-4 border-amber-500 rounded-r-xl p-4 mb-4">
                        <p class="text-xs font-extrabold uppercase tracking-wider text-amber-800 mb-2">${q.stimulusTitle}</p>
                        <div class="text-sm text-slate-800 leading-relaxed">${q.stimulusText}</div>
                    </div>

                    <!-- Pertanyaan -->
                    <p class="text-base font-bold text-slate-900 mb-4 leading-relaxed">${q.question}</p>

                    <!-- Opsi Pilihan Ganda -->
                    <div class="space-y-2.5">
                        ${optionsMarkup}
                    </div>
                `;
                container.appendChild(card);
            });
        }

        // 7. TIMER HITUNG MUNDUR 20 MENIT (OTOMATIS SUBMIT SAAT HABIS)
        function startCountdownTimer() {
            timeRemaining = 20 * 60; // 20 menit
            updateTimerDisplay();

            if (timerInterval) clearInterval(timerInterval);
            timerInterval = setInterval(() => {
                if (!isQuizActive) {
                    clearInterval(timerInterval);
                    return;
                }

                timeRemaining--;
                updateTimerDisplay();

                if (timeRemaining <= 0) {
                    clearInterval(timerInterval);
                    autoSubmitOnTimeout();
                }
            }, 1000);
        }

        function updateTimerDisplay() {
            const mins = Math.floor(timeRemaining / 60);
            const secs = timeRemaining % 60;
            document.getElementById('timer-display').textContent =
                `${String(mins).padStart(2, '0')}:${String(secs).padStart(2, '0')}`;
        }

        function autoSubmitOnTimeout() {
            isQuizActive = false;
            showToast("Waktu 20 menit telah habis! Jawaban dikumpulkan otomatis.");

            let correctCount = 0;
            const userAnswers = [];
            quizQuestions.forEach((q) => {
                const selected = document.querySelector(`input[name="question_${q.id}"]:checked`);
                const val = selected ? parseInt(selected.value, 10) : null;
                userAnswers.push(val);
                if (val === q.correctIndex) correctCount++;
            });

            showResultPage(correctCount * 20, correctCount, userAnswers);
        }

        // 8. DETEKSI PINDAH TAB / KELUAR LAYAR (ANTI-CHEAT)
        function handleTabSwitchViolation() {
            if (!isQuizActive) return;

            isQuizActive = false;
            if (timerInterval) clearInterval(timerInterval);

            // Bunyikan Alarm Keras
            startAlarmSound();

            // Tampilkan Layar Merah Gagal
            document.getElementById('cheat-student-info').textContent = `${studentName} (${studentClass})`;
            document.getElementById('cheat-overlay').classList.remove('hidden');
        }

        document.addEventListener('visibilitychange', function () {
            if (document.hidden && isQuizActive) {
                handleTabSwitchViolation();
            }
        });

        window.addEventListener('blur', function () {
            if (isQuizActive) {
                handleTabSwitchViolation();
            }
        });

        // 9. SUBMIT MANUAL OLEH SISWA
        document.getElementById('submit-quiz-btn').addEventListener('click', function () {
            let unanswered = 0;
            const userAnswers = [];

            quizQuestions.forEach((q) => {
                const selected = document.querySelector(`input[name="question_${q.id}"]:checked`);
                if (!selected) {
                    unanswered++;
                    userAnswers.push(null);
                } else {
                    userAnswers.push(parseInt(selected.value, 10));
                }
            });

            if (unanswered > 0) {
                showToast(`Masih ada ${unanswered} soal yang belum diisi. Lengkapi semua soal terlebih dahulu!`);
                return;
            }

            // Matikan mode ujian & pengawas anti-cheat
            isQuizActive = false;
            if (timerInterval) clearInterval(timerInterval);

            let correctCount = 0;
            quizQuestions.forEach((q, idx) => {
                if (userAnswers[idx] === q.correctIndex) {
                    correctCount++;
                }
            });

            showResultPage(correctCount * 20, correctCount, userAnswers);
        });

        // 10. HALAMAN HASIL & KARAKTER ANIMASI SVG
        function showResultPage(score, correctCount, userAnswers) {
            document.getElementById('quiz-section').classList.add('hidden');
            document.getElementById('active-exam-bar').classList.add('hidden');
            document.getElementById('active-exam-bar').classList.remove('flex');
            document.getElementById('result-section').classList.remove('hidden');

            document.getElementById('res-name').textContent = studentName;
            document.getElementById('res-class').textContent = studentClass;
            document.getElementById('res-score').textContent = score;
            document.getElementById('res-detail').textContent = `Menjawab benar ${correctCount} dari ${quizQuestions.length} soal HOTS`;

            const animBox = document.getElementById('result-animation-box');
            const badge = document.getElementById('result-badge');
            const title = document.getElementById('result-title');
            const msg = document.getElementById('result-message');
            const scoreEl = document.getElementById('res-score');

            if (score > 80) {
                // SKOR DI ATAS 80 -> SELAMAT DAN MANTAP + ANIMASI PIALA + KONFETI
                badge.className = "inline-block px-4 py-1.5 rounded-full text-xs sm:text-sm font-extrabold uppercase tracking-wider mb-3 bg-emerald-100 text-emerald-800";
                badge.textContent = "Lulus Dengan Predikat Sangat Baik!";
                title.className = "text-2xl sm:text-4xl font-black mb-2 text-emerald-600";
                title.textContent = "SELAMAT DAN MANTAP! 🎉";
                scoreEl.className = "text-5xl sm:text-6xl font-black text-emerald-600";
                msg.textContent = "Luar biasa! Kamu berhasil memahami konsep Report Text, struktur General Classification & Description, serta kaidah penulisan ilmiah dengan sangat tepat!";

                animBox.innerHTML = `
                    <svg class="w-44 h-44 animate-trophy" viewBox="0 0 200 200" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <circle cx="100" cy="100" r="90" fill="#D1FAE5"/>
                        <circle cx="100" cy="100" r="72" fill="#A7F3D0"/>
                        <!-- Bintang Perayaan -->
                        <path d="M38 48L41 56L49 59L41 62L38 70L35 62L27 59L35 56L38 48Z" fill="#F59E0B"/>
                        <path d="M162 44L165 52L173 55L165 58L162 66L159 58L151 55L159 52L162 44Z" fill="#F59E0B"/>
                        <!-- Karakter Gembira -->
                        <circle cx="100" cy="118" r="36" fill="#FBBF24"/>
                        <path d="M84 111C86 106 92 106 94 111" stroke="#0F172A" stroke-width="4" stroke-linecap="round"/>
                        <path d="M106 111C108 106 114 106 116 111" stroke="#0F172A" stroke-width="4" stroke-linecap="round"/>
                        <circle cx="80" cy="121" r="5" fill="#F87171" opacity="0.65"/>
                        <circle cx="120" cy="121" r="5" fill="#F87171" opacity="0.65"/>
                        <path d="M86 125C90 137 110 137 114 125Z" fill="#DC2626"/>
                        <!-- Piala Emas -->
                        <path d="M81 40H119V57C119 67 110 75 100 75C90 75 81 67 81 57V40Z" fill="#F59E0B" stroke="#B45309" stroke-width="3"/>
                        <rect x="95" y="75" width="10" height="10" fill="#B45309"/>
                        <rect x="85" y="84" width="30" height="6" rx="3" fill="#78350F"/>
                        <!-- Tangan Melambai Gembira -->
                        <path d="M62 118C50 102 48 86 56 79" stroke="#F59E0B" stroke-width="8" stroke-linecap="round" class="animate-wave"/>
                        <path d="M138 118C150 102 152 86 144 79" stroke="#F59E0B" stroke-width="8" stroke-linecap="round"/>
                    </svg>
                `;

                playVictorySound();
                launchConfetti();
            } else {
                // SKOR DI BAWAH ATAU SAMA DENGAN 80 -> YUKK SEMANGAT DAN COBA LAGI!
                badge.className = "inline-block px-4 py-1.5 rounded-full text-xs sm:text-sm font-extrabold uppercase tracking-wider mb-3 bg-amber-100 text-amber-800";
                badge.textContent = "Jangan Menyerah, Terus Berlatih!";
                title.className = "text-2xl sm:text-4xl font-black mb-2 text-amber-600";
                title.textContent = "YUKK SEMANGAT DAN COBA LAGI! 💪";
                scoreEl.className = "text-5xl sm:text-6xl font-black text-amber-600";
                msg.textContent = "Tetap semangat! Pelajari kembali perbedaan Report vs Descriptive text, urutan paragraf, serta pembahasan soal di bawah ini, lalu coba lagi untuk mencapai skor di atas 80!";

                animBox.innerHTML = `
                    <svg class="w-44 h-44 animate-bounce-slow" viewBox="0 0 200 200" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <circle cx="100" cy="100" r="90" fill="#FEF3C7"/>
                        <circle cx="100" cy="100" r="72" fill="#FDE68A"/>
                        <!-- Karakter Penyemangat -->
                        <circle cx="100" cy="110" r="38" fill="#3B82F6"/>
                        <!-- Topi Semangat -->
                        <path d="M65 92C72 68 128 68 135 92H65Z" fill="#1D4ED8"/>
                        <rect x="60" y="90" width="80" height="7" rx="3.5" fill="#1E3A8A"/>
                        <!-- Mata Berbinar -->
                        <circle cx="87" cy="108" r="4.5" fill="#0F172A"/>
                        <circle cx="113" cy="108" r="4.5" fill="#0F172A"/>
                        <circle cx="88.5" cy="106.5" r="1.5" fill="white"/>
                        <circle cx="114.5" cy="106.5" r="1.5" fill="white"/>
                        <!-- Senyum Ramah -->
                        <path d="M87 122C93 130 107 130 113 122" stroke="#0F172A" stroke-width="4" stroke-linecap="round"/>
                        <!-- Tangan Mengepal Semangat -->
                        <path d="M138 118C152 110 158 96 152 84" stroke="#2563EB" stroke-width="9" stroke-linecap="round" class="animate-wave"/>
                        <circle cx="152" cy="82" r="8" fill="#FBBF24"/>
                        <!-- Api Semangat & Hati -->
                        <path d="M52 86C44 76 48 62 56 56C55 64 60 66 62 60C68 68 66 80 58 86H52Z" fill="#F97316" class="animate-flame"/>
                        <path d="M148 56C148 50 155 48 157 54C159 48 166 50 166 56C166 62 157 69 157 69C157 69 148 62 148 56Z" fill="#EF4444"/>
                    </svg>
                `;

                playEncourageSound();
            }

            renderReview(userAnswers);
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        function renderReview(userAnswers) {
            const container = document.getElementById('review-container');
            container.innerHTML = '';

            quizQuestions.forEach((q, idx) => {
                const userVal = userAnswers[idx];
                const isCorrect = userVal === q.correctIndex;
                const userText = userVal !== null ? q.options[userVal] : "Tidak dijawab (Waktu habis)";

                const item = document.createElement('div');
                item.className = `p-4 rounded-xl border ${isCorrect ? 'bg-emerald-50/60 border-emerald-200' : 'bg-rose-50/60 border-rose-200'}`;

                item.innerHTML = `
                    <div class="flex items-center justify-between gap-2 mb-1.5">
                        <span class="text-xs font-extrabold ${isCorrect ? 'text-emerald-700' : 'text-rose-700'}">
                            Soal ${idx + 1}: ${isCorrect ? 'BENAR (+20 Poin)' : 'KURANG TEPAT (0 Poin)'}
                        </span>
                    </div>
                    <p class="text-xs sm:text-sm font-bold text-slate-800 mb-2">${q.question}</p>
                    <p class="text-xs text-slate-600 mb-1">Jawaban Anda: <strong class="${isCorrect ? 'text-emerald-700' : 'text-rose-700'}">${userText}</strong></p>
                    ${!isCorrect ? `<p class="text-xs text-emerald-800 mb-1">Kunci Jawaban: <strong>${q.options[q.correctIndex]}</strong></p>` : ''}
                    <p class="text-xs text-slate-700 bg-white p-2.5 rounded-lg border border-slate-200 mt-2">
                        <strong>Pembahasan:</strong> ${q.explanation}
                    </p>
                `;
                container.appendChild(item);
            });
        }

        // 11. RESET APLIKASI
        function resetApplication() {
            stopAlarmSound();
            isQuizActive = false;
            if (timerInterval) clearInterval(timerInterval);

            document.getElementById('cheat-overlay').classList.add('hidden');
            document.getElementById('result-section').classList.add('hidden');
            document.getElementById('quiz-section').classList.add('hidden');
            document.getElementById('active-exam-bar').classList.add('hidden');
            document.getElementById('active-exam-bar').classList.remove('flex');
            document.getElementById('intro-section').classList.remove('hidden');

            const canvas = document.getElementById('confetti-canvas');
            const ctx = canvas.getContext('2d');
            ctx.clearRect(0, 0, canvas.width, canvas.height);

            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        // 12. EFEK KONFETI KEMENANGAN
        function launchConfetti() {
            const canvas = document.getElementById('confetti-canvas');
            const ctx = canvas.getContext('2d');
            canvas.width = window.innerWidth;
            canvas.height = window.innerHeight;

            const colors = ['#10b981', '#2563eb', '#f59e0b', '#ec4899', '#8b5cf6'];
            const pieces = Array.from({ length: 130 }, () => ({
                x: Math.random() * canvas.width,
                y: Math.random() * canvas.height - canvas.height,
                size: Math.random() * 8 + 5,
                color: colors[Math.floor(Math.random() * colors.length)],
                speedY: Math.random() * 3.5 + 2,
                speedX: Math.random() * 2 - 1,
                rotation: Math.random() * 360
            }));

            let frame = 0;
            function animate() {
                ctx.clearRect(0, 0, canvas.width, canvas.height);
                pieces.forEach(p => {
                    p.y += p.speedY;
                    p.x += p.speedX;
                    p.rotation += 4;

                    ctx.save();
                    ctx.translate(p.x, p.y);
                    ctx.rotate((p.rotation * Math.PI) / 180);
                    ctx.fillStyle = p.color;
                    ctx.fillRect(-p.size / 2, -p.size / 2, p.size, p.size * 0.6);
                    ctx.restore();
                });

                frame++;
                if (frame < 240) {
                    requestAnimationFrame(animate);
                } else {
                    ctx.clearRect(0, 0, canvas.width, canvas.height);
                }
            }
            animate();
        }
    </script>
